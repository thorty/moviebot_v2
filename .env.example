# cp .env.example .env

# ---- Core LLM / Tools (existing POC) ----
OPENAI_API_KEY=
TAVILY_API_KEY=
#SERPER_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=moviebot
