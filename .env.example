# Moviebot - Local Environment Example
# Copy to .env and fill with real values:
# cp .env.example .env

# ---- Core LLM / Tools ----
GOOGLE_API_KEY=
GOOGLE_MODEL_ANALYST=gemini-2.5-flash
GOOGLE_MODEL_RESEARCHER=gemini-2.5-flash
GOOGLE_SEARCH_MODEL=gemini-2.5-flash
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=moviebot
TMDB_BEARER=

# Legacy alias (optional, kept for compatibility with older scripts)
# tmdb_bearer=

# ---- Fullstack MVP (Supabase + API) ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- App Endpoints ----
BACKEND_API_URL=http://localhost:8000
FRONTEND_WEB_URL=http://localhost:3000
