# Moviebot - Local Environment Example
# Copy to .env and fill with real values:
# cp .env.example .env

# ---- Core LLM / Tools ----
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_RESEARCH=gpt-5.4
OPENAI_WEB_SEARCH_CONTEXT=low
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=moviebot
TMDB_BEARER=

# Legacy alias (optional, kept for compatibility with older scripts)
# tmdb_bearer=

# ---- Fullstack MVP (Supabase + API) ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- App Endpoints ----
BACKEND_API_URL=http://localhost:8000
FRONTEND_WEB_URL=http://localhost:3000
